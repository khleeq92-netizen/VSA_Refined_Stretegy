// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// UHV Sweep Reversal — RESEARCH strategy for Deep Backtesting on OANDA:XAUUSD M5.
// Mirrors the Python research engine (research/backtest_v5.py and research/backtest_v2.py).
// Purpose: multi-year validation. It is NOT a validated live-trading system.
//
// Default setup (rebuilt from the trader's chart examples, 11/12/16/19-Nov-2026) + best research filters:
//  BUY : UHV candle range >= 2 x ATR(20); no Asia-session entries; ATR exits (SL 3.5 ATR, TP 2.25 ATR, 100% at TP).
//  SELL: UHV volume >= 2.5 x average; no entries in the London-NY overlap; 50% at 100 pips, rest at 2 x SL.
//  BUY : selling climax in the lower part of the range -> the UHV candle is the VOLUME PEAK of that climax
//        (red, volume >= 2x avg, higher than the 2 candles before and the candle after) -> a later candle
//        sweeps the UHV low -> within 12 bars a bullish candle CLOSES above the UHV high -> enter next open
//        -> SL 160 pips, 50% at 120 pips,
//        rest at 2 x SL. 1 pip = $0.10.
//  SELL: exact mirror.
// All signals use confirmed bars. Higher-timeframe zones use completed HTF candles only (no repainting).
// Run BUY-only and SELL-only as separate backtests to match the research.
// Works on OANDA:XAUUSD (tick volume) and COMEX GC1! (real futures volume): position size uses syminfo.pointvalue.
// On GC1! set Properties -> Commission to about 15 USD per contract (≈ the $0.15/oz spread + fees of one side).
//@version=6
strategy("UHV Sweep Reversal [research]", overlay = true, initial_capital = 100000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.20,
     slippage = 0, process_orders_on_close = false, calc_on_every_tick = false,
     max_labels_count = 500, max_lines_count = 500)

// ───────── General
gG = "General"
dirMode   = input.string("Buy only", "Direction", options = ["Buy only", "Sell only", "Both"], group = gG,
     tooltip = "Run Buy only and Sell only as separate backtests to match the research.")
startT    = input.time(timestamp("2021-01-01T00:00:00"), "Backtest start", group = gG)
endT      = input.time(timestamp("2030-01-01T00:00:00"), "Backtest end", group = gG)
setupSel  = input.string("A only", "Setups", options = ["A only", "B only", "A + B"], group = gG,
     tooltip = "A = UHV sweep reversal (your model). B = low-volume pullback (No Supply) after a bullish UHV displacement. B is experimental.")
riskUSD   = input.float(100, "Risk per trade ($) — profit / this = R", minval = 1, group = gG)
sessMode  = input.string("All sessions", "Trade in", options = ["All sessions", "Custom session"], group = gG)
custSess  = input.session("0800-1700", "Custom session", group = gG)
custTZ    = input.string("America/New_York", "Custom session time zone", options = ["America/New_York", "Europe/London", "Asia/Kolkata", "Asia/Tokyo", "UTC"], group = gG)

// ───────── UHV detector (your indicator guide, Part 4)
gU = "UHV detector"
uhvPick   = input.string("Volume peak", "Which candle is the UHV", options = ["Volume peak", "Big candle"], group = gU,
     tooltip = "Volume peak: the highest-volume candle of the climax (body size not required) — matches your 19-Nov example. Big candle: your indicator's Part 4 rules incl. body >= 1.2x.")
vmBuy     = input.float(2.0, "BUY UHV multiplier (x avg volume)", step = 0.1, group = gU)
vmSell    = input.float(2.5, "SELL UHV multiplier (x avg volume)", step = 0.1, group = gU)
nAvg      = input.int(40, "Lookback for volume / size averages", group = gU)
bodyK     = input.float(1.2, "Body >= x average body (Big candle only)", step = 0.1, group = gU)
rangeK    = input.float(1.2, "Range >= x average range", step = 0.1, group = gU)
posN      = input.int(50, "Range lookback for location test", group = gU)
posMax    = input.float(0.65, "BUY: max position in range (0=low,1=high); SELL uses 1 - this", step = 0.05, group = gU)
runN      = input.int(6, "Run: look back this many candles", group = gU)
runMin    = input.int(4, "Run: at least this many against-colour candles", group = gU)
runVol    = input.float(0.8, "Run: avg volume >= x average", step = 0.1, group = gU)
useOv     = input.bool(true, "Exceptional volume can override the run rule", group = gU)
excK      = input.float(4.0, "Exceptional = x average volume", step = 0.5, group = gU)
excN      = input.int(400, "...or highest volume of this many candles", group = gU)
ovReds    = input.int(2, "Against-colour candles still required on override", group = gU)
bgN       = input.int(12, "Background lookback", group = gU)
emaN      = input.int(50, "Background EMA length", group = gU)
bgShare   = input.float(0.55, "Background colour share", step = 0.05, group = gU)
bgNeed    = input.int(2, "Background tests that must pass (of 3)", minval = 1, maxval = 3, group = gU)

// ───────── Setup / entry
gS = "Setup and entry"
entryMode = input.string("Candle close beyond", "Entry", options = ["Break of UHV extreme (stop order)", "Candle close beyond"], group = gS)
sweepMax  = input.int(288, "Max bars from UHV to sweep", group = gS)
cancelOpp = input.bool(false, "Cancel setup if price closes beyond the opposite UHV extreme before the sweep", group = gS,
     tooltip = "Off = your 11-Nov example stays valid (price closed below the UHV low before sweeping its high).")
trigMax   = input.int(12, "Max bars from sweep to entry", group = gS)
entBuf    = input.float(0.10, "Stop-order buffer beyond UHV extreme ($)", step = 0.05, group = gS)
useCisd   = input.bool(false, "Require close beyond the CISD candle too (close entry only)", group = gS)
cisdRef   = input.string("High/Low", "CISD candle level", options = ["High/Low", "Open"], group = gS)
slBuf     = input.float(0.10, "Structural SL buffer ($)", step = 0.05, group = gS)

// ───────── Quality filters (research candidates — off by default; test them as separate Deep Backtest runs)
gQ = "Quality filters"
minRngB   = input.float(2.0, "BUY: UHV candle range >= x ATR(20) (0 = off)", step = 0.25, group = gQ)
minRngS   = input.float(0.0, "SELL: UHV candle range >= x ATR(20) (0 = off)", step = 0.25, group = gQ)
skipAsia  = input.bool(true, "Skip the Asia session (trade only London 07:00–16:30 or New York 08:00–17:00 local)", group = gQ,
     tooltip = "5-year research: Asia-session buys were the weakest; skipping them raised PF from 1.07 to 1.38 (ATR exits, 2023–2026).")
skipOvlB  = input.bool(false, "BUY: skip entries in the London–New York overlap", group = gQ)
skipOvl   = input.bool(true, "SELL: skip entries in the London–New York overlap", group = gQ,
     tooltip = "Overlap = London 08:00–16:30 AND New York 08:00–17:00 local times (DST-aware).")

// ───────── Higher-timeframe zone filter
gZ = "HTF zone filter (UHV candle must overlap an active zone)"
useZone   = input.bool(false, "Require HTF zone", group = gZ)
zM15F     = input.bool(true, "M15 FVG", group = gZ, inline = "z1")
zH1F      = input.bool(true, "H1 FVG", group = gZ, inline = "z1")
zH4F      = input.bool(true, "H4 FVG", group = gZ, inline = "z1")
zM15O     = input.bool(true, "M15 demand/supply", group = gZ, inline = "z2")
zH1O      = input.bool(true, "H1 demand/supply", group = gZ, inline = "z2")
zH4O      = input.bool(true, "H4 demand/supply", group = gZ, inline = "z2")
zoneDays  = input.int(5, "Zone max age (days)", group = gZ)

// ───────── Exits
gX = "Exits"
exitMode  = input.string("ATR multiples", "Exit mode", options = ["ATR multiples", "Fixed pips", "Structural (R)"], group = gX,
     tooltip = "Fixed pips: SL / TP1 in pips, final TP = Final TP (R) x SL. Structural: SL beyond the sweep extreme, TPs in R.")
pipSize   = input.float(0.10, "Pip size ($) — XAUUSD 1 pip = 0.10", step = 0.01, group = gX)
slPips    = input.float(160, "Fixed SL (pips)", group = gX)
tp1Pips   = input.float(100, "Fixed TP1 / safer target (pips)", group = gX)
tp1R      = input.float(1.0, "Structural TP1 (R)", step = 0.25, group = gX)
tp2R      = input.float(2.0, "Final TP (R)", step = 0.25, group = gX)
tp1PctB   = input.float(100, "BUY: % closed at TP1 (100 = single target)", minval = 0, maxval = 100, group = gX)
tp1PctS   = input.float(50, "SELL: % closed at TP1 (rest runs to Final TP)", minval = 0, maxval = 100, group = gX)
useBE     = input.bool(false, "Move SL to breakeven after TP1", group = gX)
maxHold   = input.int(96, "Time exit after N bars", group = gX)
slAtrK    = input.float(3.5, "ATR mode: SL = x ATR(20)  (3.5 ≈ 160 pips at 2026 volatility)", step = 0.25, group = gX)
tp1AtrK   = input.float(2.25, "ATR mode: TP1 = x ATR(20) (2.25 ≈ 100 pips at 2026 volatility)", step = 0.25, group = gX)

gR = "Regime filters"
useTrend  = input.bool(false, "Daily trend filter: BUY only above daily SMA, SELL only below", group = gR)
trendLen  = input.int(50, "Daily SMA length", group = gR)
minAtrUSD = input.float(0.0, "Minimum M5 ATR(20) in $ to take a setup (0 = off)", step = 0.25, group = gR,
     tooltip = "The 2021-2024 losses came from quiet markets. Example: 2.5 = skip setups when the average M5 range is below $2.50 (25 pips).")

// ═════════ UHV detection
vAvg   = ta.sma(volume, nAvg)
bodyV  = math.abs(close - open)
rangeOK = (high - low) >= rangeK * ta.sma(high - low, nAvg)
bodyOK  = bodyV >= bodyK * ta.sma(bodyV, nAvg)
hhP    = ta.highest(high, posN)
llP    = ta.lowest(low, posN)
posR   = hhP > llP ? (close - llP) / (hhP - llP) : 0.5
excV   = volume >= excK * vAvg or volume >= ta.highest(volume, excN)
emaV   = ta.ema(close, emaN)
pickBig = uhvPick == "Big candle"

f_uhv(bool isBuy, float vm) =>
    bool  against = isBuy ? close < open : close > open
    float ag1  = (isBuy ? close[1] < open[1] : close[1] > open[1]) ? 1.0 : 0.0
    float cnt  = math.sum(ag1, runN)
    float runV = cnt > 0 ? math.sum(ag1 * volume[1], runN) / cnt : 0.0
    bool  normalOK = cnt >= runMin and runV >= runVol * vAvg
    float t1 = (isBuy ? close < emaV : close > emaV) ? 1 : 0
    float t2 = (isBuy ? close < close[bgN] : close > close[bgN]) ? 1 : 0
    float t3 = math.sum(against ? 1.0 : 0.0, bgN) / bgN >= bgShare ? 1 : 0
    bool  ovOK = useOv and excV and (t1 + t2 + t3) >= bgNeed and cnt >= ovReds
    bool  locOK = isBuy ? posR <= posMax : posR >= 1 - posMax
    against and volume > vm * vAvg and rangeOK and (pickBig ? bodyOK : true) and locOK and (normalOK or ovOK)

rawBuy  = f_uhv(true, vmBuy)
rawSell = f_uhv(false, vmSell)
// Volume peak: candle [1] had more volume than the 2 before it and than the current candle (confirmed now)
peakPrev = volume[1] >= volume[2] and volume[1] >= volume[3] and volume < volume[1]
uhvBuy   = pickBig ? rawBuy  : (rawBuy[1]  and peakPrev)
uhvSell  = pickBig ? rawSell : (rawSell[1] and peakPrev)
uOff     = pickBig ? 0 : 1          // bars back from the current bar to the UHV candle

// ═════════ HTF zones from COMPLETED higher-timeframe candles (lookahead_on + [1] offsets = no repaint)
f_htf() =>
    float atrP = ta.sma(ta.tr(true), 14)[2]
    bool  bullF = low[1] > high[3]
    bool  bearF = high[1] < low[3]
    float dB = na
    float dT = na
    float sB = na
    float sT = na
    if high[1] - low[1] >= 1.5 * atrP
        if close[1] > open[1]
            for j = 2 to 6
                if close[j] < open[j]
                    if close[1] > high[j]
                        dB := low[j]
                        dT := high[j]
                    break
        if close[1] < open[1]
            for j = 2 to 6
                if close[j] > open[j]
                    if close[1] < low[j]
                        sB := low[j]
                        sT := high[j]
                    break
    [bullF, high[3], low[1], bearF, high[1], low[3], dB, dT, sB, sT, time[1]]

[aBF, aBb, aBt, aSF, aSb, aSt, aDB, aDT, aSB, aST, aT] = request.security(syminfo.tickerid, "15",  f_htf(), lookahead = barmerge.lookahead_on)
[bBF, bBb, bBt, bSF, bSb, bSt, bDB, bDT, bSB, bST, bT] = request.security(syminfo.tickerid, "60",  f_htf(), lookahead = barmerge.lookahead_on)
[cBF, cBb, cBt, cSF, cSb, cSt, cDB, cDT, cSB, cST, cT] = request.security(syminfo.tickerid, "240", f_htf(), lookahead = barmerge.lookahead_on)

var zBot  = array.new_float()
var zTop  = array.new_float()
var zSide = array.new_int()
var zExp  = array.new_int()
expMs = zoneDays * 86400000

f_add(float b, float t, int sd) =>
    if not na(b) and not na(t) and t > b
        array.push(zBot, b)
        array.push(zTop, t)
        array.push(zSide, sd)
        array.push(zExp, time + expMs)

if useZone
    if ta.change(aT) != 0
        if zM15F and aBF
            f_add(aBb, aBt, 1)
        if zM15F and aSF
            f_add(aSb, aSt, -1)
        if zM15O
            f_add(aDB, aDT, 1)
            f_add(aSB, aST, -1)
    if ta.change(bT) != 0
        if zH1F and bBF
            f_add(bBb, bBt, 1)
        if zH1F and bSF
            f_add(bSb, bSt, -1)
        if zH1O
            f_add(bDB, bDT, 1)
            f_add(bSB, bST, -1)
    if ta.change(cT) != 0
        if zH4F and cBF
            f_add(cBb, cBt, 1)
        if zH4F and cSF
            f_add(cSb, cSt, -1)
        if zH4O
            f_add(cDB, cDT, 1)
            f_add(cSB, cST, -1)

bool hitBull = false
bool hitBear = false
if useZone and array.size(zBot) > 0
    for i = array.size(zBot) - 1 to 0
        float b = array.get(zBot, i)
        float t = array.get(zTop, i)
        int   sd = array.get(zSide, i)
        bool  dead = time > array.get(zExp, i)
        if not dead
            bool ov = low <= t and high >= b
            if sd == 1
                hitBull := hitBull or ov
                dead := close < b
            else
                hitBear := hitBear or ov
                dead := close > t
        if dead
            array.remove(zBot, i)
            array.remove(zTop, i)
            array.remove(zSide, i)
            array.remove(zExp, i)
zoneBull = pickBig ? hitBull : hitBull[1]
zoneBear = pickBig ? hitBear : hitBear[1]

// ═════════ Common filters
inDate  = time >= startT and time < endT
inSessRaw = sessMode == "All sessions" or not na(time(timeframe.period, custSess, custTZ))
flat    = strategy.position_size == 0
allowB  = dirMode != "Sell only"
allowS  = dirMode != "Buy only"
stopEnt = entryMode == "Break of UHV extreme (stop order)"
fixedX  = exitMode != "Structural (R)"          // fixed-distance exits (pips or ATR), placed relative to the fill
toTicks(float px) => math.round(px / syminfo.mintick)
atr20   = ta.sma(ta.tr(true), 20)[1]
fixRisk = exitMode == "Fixed pips" ? slPips * pipSize : slAtrK * atr20
tp1Dist = exitMode == "Fixed pips" ? tp1Pips * pipSize : tp1AtrK * atr20
dSma    = request.security(syminfo.tickerid, "D", ta.sma(close, trendLen)[1], lookahead = barmerge.lookahead_on)
regB    = (not useTrend or close > dSma) and atr20 >= minAtrUSD
regS    = (not useTrend or close < dSma) and atr20 >= minAtrUSD
uRngAtr = (high[uOff] - low[uOff]) / atr20[uOff]
inLon   = not na(time(timeframe.period, "0800-1630", "Europe/London"))
inNY    = not na(time(timeframe.period, "0800-1700", "America/New_York"))
inLonW  = not na(time(timeframe.period, "0700-1630", "Europe/London"))
asiaOK  = not skipAsia or inLonW or inNY
inSessB = inSessRaw and asiaOK and not (skipOvlB and inLon and inNY)
inSessS = inSessRaw and asiaOK and not (skipOvl and inLon and inNY)

// CISD candle: first candle of the against-colour run ending at the UHV candle (inside candle -> mother candle)
f_cisd(bool isBuy, int off) =>
    int j = off
    for k = off + 1 to off + 30
        bool ag = isBuy ? close[k] < open[k] : close[k] > open[k]
        if not ag
            break
        j := k
    for k = 1 to 10
        if high[j] <= high[j + 1] and low[j] >= low[j + 1]
            j := j + 1
        else
            break
    cisdRef == "Open" ? open[j] : (isBuy ? high[j] : low[j])

// Places entry + exits. Fixed pips: exits are relative to the actual fill (profit/loss in ticks).
f_orders(bool isLong, float entryPx, float structSL, bool asStop) =>
    string id = isLong ? "L" : "S"
    float  pct = isLong ? tp1PctB : tp1PctS
    float  risk = fixedX ? fixRisk : math.abs(entryPx - structSL)
    float  qty = riskUSD / (risk * syminfo.pointvalue)   // pointvalue: 1 for OANDA spot (per oz), 100 for COMEX GC (per contract)
    if asStop
        strategy.entry(id, isLong ? strategy.long : strategy.short, qty = qty, stop = entryPx)
    else
        strategy.entry(id, isLong ? strategy.long : strategy.short, qty = qty)
    if fixedX
        int lossT = toTicks(fixRisk)
        if pct > 0
            strategy.exit(id + "-TP1", id, qty_percent = pct, profit = toTicks(tp1Dist), loss = lossT)
        strategy.exit(id + "-TP2", id, profit = toTicks(tp2R * fixRisk), loss = lossT)
    else
        float d = isLong ? 1.0 : -1.0
        if pct > 0
            strategy.exit(id + "-TP1", id, qty_percent = pct, limit = entryPx + d * tp1R * risk, stop = structSL)
        strategy.exit(id + "-TP2", id, limit = entryPx + d * tp2R * risk, stop = structSL)

// In "Both" mode only one side may fire per bar (BUY has priority)
bool firedB = false

useA = setupSel != "B only"
useB = setupSel != "A only"

// ═════════ BUY setup state machine
var bool  bAct = false
var bool  bSw = false
var int   bU = na
var int   bSwBar = na
var float bH = na
var float bL = na
var float bLow = na
var float bLvl = na

if bAct and not flat
    bAct := false
if bAct and bar_index > bU
    bLow := math.min(bLow, low)
    if not bSw
        if low < bL
            bSw := true
            bSwBar := bar_index
        else if (cancelOpp and close > bH) or bar_index - bU >= sweepMax
            bAct := false
    else if bar_index > bSwBar
        int since = bar_index - bSwBar
        if stopEnt
            if since < trigMax and inSessB and inDate and allowB and flat
                f_orders(true, bH + entBuf, bLow - slBuf, true)
                firedB := true
            else if since >= trigMax
                strategy.cancel("L")
                bAct := false
        else
            if since > trigMax
                bAct := false
            else if close > open and close > bLvl
                if inSessB and inDate and flat and allowB
                    f_orders(true, close, bLow - slBuf, false)
                    firedB := true
                bAct := false

if useA and not bAct and uhvBuy and flat and allowB and (not useZone or zoneBull) and uRngAtr >= minRngB and regB
    bAct := true
    bSw := false
    bU := bar_index - uOff
    bH := high[uOff]
    bL := low[uOff]
    bLow := math.min(low[uOff], low)
    bLvl := useCisd and not stopEnt ? math.max(bH, f_cisd(true, uOff)) : bH
    if uOff == 1
        if low < bL
            bSw := true
            bSwBar := bar_index
        else if cancelOpp and close > bH
            bAct := false

// ═════════ SETUP B (BUY): low-volume pullback (No Supply) after a bullish UHV displacement
// 1. Displacement: green, volume >= 2x avg, range >= 1.5x ATR, close in the top 30% of its range.
// 2. Within 24 candles: No Supply = red, range <= 0.8x ATR, volume below each of the 2 previous candles and
//    <= 0.8x avg, pullback low stays above the displacement candle's midpoint.
// 3. Within 6 candles of the No Supply candle: a candle CLOSES above its high -> buy next open.
gBs = "Setup B (experimental)"
bDispVol = input.float(2.0, "Displacement volume >= x avg", step = 0.25, group = gBs)
bDispRng = input.float(1.5, "Displacement range >= x ATR", step = 0.25, group = gBs)
bNsRng   = input.float(0.8, "No Supply range <= x ATR", step = 0.1, group = gBs)
bNsVol   = input.float(0.8, "No Supply volume <= x avg", step = 0.1, group = gBs)
var int   pbDisp = na
var float pbMid = na
var float pbLow = na
var bool  pbArm = false
var float pbNsH = na
var int   pbNsBar = na
dispB = close > open and volume >= bDispVol * vAvg and (high - low) >= bDispRng * atr20 and (close - low) >= 0.7 * (high - low)
if useB and allowB
    if not na(pbDisp) and bar_index > pbDisp
        pbLow := math.min(pbLow, low)
        if low < pbMid or not flat
            pbDisp := na
            pbArm := false
        else
            if pbArm and bar_index - pbNsBar > 6
                pbArm := false
            if pbArm and close > pbNsH
                if inSessB and inDate and flat and regB and not firedB
                    f_orders(true, close, pbLow - slBuf, false)
                    firedB := true
                pbArm := false
            else if bar_index - pbDisp <= 24 and close < open and (high - low) <= bNsRng * atr20 and volume < volume[1] and volume < volume[2] and volume <= bNsVol * vAvg
                pbArm := true
                pbNsH := high
                pbNsBar := bar_index
            if bar_index - pbDisp > 24 and not pbArm
                pbDisp := na
    if dispB and flat
        pbDisp := bar_index
        pbMid := (high + low) / 2
        pbLow := low
        pbArm := false
plotshape(useB and dispB and allowB, "B displacement", shape.diamond, location.belowbar, color.new(color.blue, 30), size = size.tiny)

// ═════════ SELL setup state machine (mirror)
var bool  sAct = false
var bool  sSw = false
var int   sU = na
var int   sSwBar = na
var float sH = na
var float sL = na
var float sHigh = na
var float sLvl = na

if sAct and not flat
    sAct := false
if sAct and bar_index > sU
    sHigh := math.max(sHigh, high)
    if not sSw
        if high > sH
            sSw := true
            sSwBar := bar_index
        else if (cancelOpp and close < sL) or bar_index - sU >= sweepMax
            sAct := false
    else if bar_index > sSwBar
        int since = bar_index - sSwBar
        if stopEnt
            if since < trigMax and inSessS and inDate and allowS and flat and not firedB
                f_orders(false, sL - entBuf, sHigh + slBuf, true)
            else if since >= trigMax
                strategy.cancel("S")
                sAct := false
        else
            if since > trigMax
                sAct := false
            else if close < open and close < sLvl
                if inSessS and inDate and flat and allowS and not firedB
                    f_orders(false, close, sHigh + slBuf, false)
                sAct := false

if not sAct and uhvSell and flat and allowS and not firedB and (not useZone or zoneBear) and uRngAtr >= minRngS and regS
    sAct := true
    sSw := false
    sU := bar_index - uOff
    sH := high[uOff]
    sL := low[uOff]
    sHigh := math.max(high[uOff], high)
    sLvl := useCisd and not stopEnt ? math.min(sL, f_cisd(false, uOff)) : sL
    if uOff == 1
        if high > sH
            sSw := true
            sSwBar := bar_index
        else if cancelOpp and close < sL
            sAct := false

// Stop-entry mode: arm the stop order at the close of the sweep candle (active from the next candle)
if bAct and bSw and stopEnt and bar_index == bSwBar and inSessB and inDate and allowB and flat
    f_orders(true, bH + entBuf, bLow - slBuf, true)
    firedB := true
if sAct and sSw and stopEnt and bar_index == sSwBar and inSessS and inDate and allowS and flat and not firedB
    f_orders(false, sL - entBuf, sHigh + slBuf, true)

// ═════════ Position management: breakeven after TP1, time exit, level lines
var float entQty = 0.0
var bool  beDone = false
var int   fillBar = na
var float slLine = na
var float tpLine = na
if strategy.position_size != 0 and nz(strategy.position_size[1]) == 0
    entQty := math.abs(strategy.position_size)
    beDone := false
    fillBar := bar_index
    float ep = strategy.position_avg_price
    float dd = strategy.position_size > 0 ? 1.0 : -1.0
    float rk = fixedX ? fixRisk : math.abs(ep - (dd > 0 ? bLow - slBuf : sHigh + slBuf))
    slLine := ep - dd * rk
    tpLine := ep + dd * tp2R * rk
curPct = strategy.position_size > 0 ? tp1PctB : tp1PctS
if useBE and curPct > 0 and curPct < 100 and not beDone and strategy.position_size != 0 and math.abs(strategy.position_size) < entQty * 0.999
    beDone := true
    slLine := strategy.position_avg_price
    if strategy.position_size > 0
        strategy.exit("L-TP2", "L", limit = tpLine, stop = slLine)
    else
        strategy.exit("S-TP2", "S", limit = tpLine, stop = slLine)
if not flat and not na(fillBar) and bar_index - fillBar >= maxHold
    strategy.close_all(comment = "time")

// ═════════ Alerts and visuals
if bAct and bSw and bar_index == bSwBar
    alert("UHV BUY setup armed: UHV low swept. Buy-stop / trigger level " + str.tostring(bH + entBuf, format.mintick), alert.freq_once_per_bar_close)
if sAct and sSw and bar_index == sSwBar
    alert("UHV SELL setup armed: UHV high swept. Sell-stop / trigger level " + str.tostring(sL - entBuf, format.mintick), alert.freq_once_per_bar_close)

plot(not flat ? slLine : na, "SL", color.red, 1, plot.style_linebr)
plot(not flat ? tpLine : na, "Final TP", color.green, 2, plot.style_linebr)
plot(bAct and bSw ? bH + entBuf : na, "Buy trigger", color.new(color.teal, 30), 1, plot.style_linebr)
plot(sAct and sSw ? sL - entBuf : na, "Sell trigger", color.new(color.maroon, 30), 1, plot.style_linebr)
plotshape(uhvBuy and allowB, "UHV buy candle", shape.triangleup, location.belowbar, color.teal, offset = -uOff, size = size.tiny)
plotshape(uhvSell and allowS, "UHV sell candle", shape.triangledown, location.abovebar, color.maroon, offset = -uOff, size = size.tiny)
plotshape(bAct and bSw and bar_index == bSwBar, "Buy sweep", shape.xcross, location.belowbar, color.teal, size = size.tiny)
plotshape(sAct and sSw and bar_index == sSwBar, "Sell sweep", shape.xcross, location.abovebar, color.maroon, size = size.tiny)
